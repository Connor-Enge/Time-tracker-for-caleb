# Neon Postgres connection string (pooled URL is recommended)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Secret for signing session JWTs (use a long random string, e.g. `openssl rand -hex 64`)
JWT_SECRET=replace-me-with-a-long-random-string

# When set to "true", the first signed-up user is promoted to admin automatically
PROMOTE_FIRST_USER_TO_ADMIN=true
